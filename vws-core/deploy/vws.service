[Unit]
Description=Project V guarded paper desk
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=vws
Group=vws
WorkingDirectory=/opt/vws-core
# SEC-LOADER: no environment file. Secrets come only from encrypted systemd
# credentials (systemd-creds encrypt --with-key=tpm2, or host+tpm2; host-only
# is weaker and must be written down). Files land in $CREDENTIALS_DIRECTORY.
LoadCredentialEncrypted=vws.alpaca_paper_key_id:/etc/credstore.encrypted/vws.alpaca_paper_key_id
LoadCredentialEncrypted=vws.alpaca_paper_secret:/etc/credstore.encrypted/vws.alpaca_paper_secret
LoadCredentialEncrypted=vws.telegram_bot_token:/etc/credstore.encrypted/vws.telegram_bot_token
LoadCredentialEncrypted=vws.telegram_callback_secret:/etc/credstore.encrypted/vws.telegram_callback_secret
LoadCredentialEncrypted=vws.vws_fingerprint_salt:/etc/credstore.encrypted/vws.vws_fingerprint_salt
Environment=PYTHONDONTWRITEBYTECODE=1
# THEME-CAPS (paper, item 17): non-secret risk setting for the deployed host. The
# process environment wins over the host .env; keep in step with .env.example.
Environment='THEME_CAPS={"AI_SEMIS":"0.25","CLOUD":"0.25","CONSUMER_TECH":"0.25"}'
ExecStart=/opt/vws-core/.venv/bin/python -m vws start
Restart=on-failure
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Keep the owned user bus visible for native Secret Service; never writable.
ProtectHome=read-only
ReadWritePaths=/opt/vws-core/data /opt/vws-core/logs /opt/vws-core/backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=multi-user.target
